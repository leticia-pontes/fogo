{
  "name": "fogo-nexus",
  "version": "1.0.0",
  "engines": {
    "node": ">=22.13.0",
    "npm": ">=10"
  },
  "scripts": {
    "ng": "ng",
    "start": "node scripts/dev.mjs",
    "start:web": "ng serve",
    "api": "tsx server/main.ts",
    "serve": "ng build && tsx server/main.ts",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "reset": "tsx server/reset.ts",
    "sintetico": "tsx server/synthetic.ts",
    "test": "ng test --watch=false && npm run test:server",
    "test:server": "vitest run --config vitest.server.config.mts"
  },
  "private": true,
  "dependencies": {
    "@angular/common": "^21.0.0",
    "@angular/compiler": "^21.0.0",
    "@angular/core": "^21.0.0",
    "@angular/forms": "^21.0.0",
    "@angular/platform-browser": "^21.0.0",
    "@angular/router": "^21.0.0",
    "@lucide/angular": "^1.59.0",
    "leaflet": "^1.9.4",
    "leaflet.markercluster": "1.5.3",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "uuid": "^11.1.1",
    "zone.js": "~0.15.0"
  },
  "devDependencies": {
    "@angular/build": "^21.2.27",
    "@angular/cli": "^21.0.0",
    "@angular/compiler-cli": "^21.0.0",
    "@types/leaflet": "^1.9.16",
    "@types/leaflet.markercluster": "1.5.6",
    "@types/node": "^22.20.5",
    "autoprefixer": "^10.4.20",
    "jsdom": "^30.1.3",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.19",
    "tsx": "^4.23.15",
    "typescript": "~5.9.0",
    "vitest": "^4.1.12"
  },
  "overrides": {
    "uuid": "^11.1.1"
  }
}
